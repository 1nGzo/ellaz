# Optional cloud services: blank means no cloud requests.
# Set BOTH to your own Firebase project, then rebuild.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=

# Optional anonymous PostHog analytics. No key means dev console only / prod silent.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Canonical/share origin and optional GA ID live in site.config.json.
# Default origin is local; GA is disabled. Never copy upstream service identities.
